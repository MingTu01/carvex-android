.gradle/
.kotlin/
**/build/
local.properties
.tools/
# 签名材料公开：.signing/keystore.properties 与 release.jks 随仓库分发，用于可复现构建。
artifacts/
# assembleRelease 的产物（APK、mapping.txt、output-metadata.json），不属源码。
app/release/
app/*/release/
# 上面那条 `app/*/release/` 会顺带匹配到 app/src/release/ —— 那是 release **源集**
# （只放了正式包要摘掉的组件），属于源码，必须放回来。
!/app/src/release/
*.log

# Local JDK, Android SDK and Gradle cache
local-build/

# Python 缓存（tools/*.py 本地工具运行时会生成）
__pycache__/
*.pyc

# IDE 工程文件：Android Studio 本地生成，路径含本机项目名，不进仓库。
.idea/

# 监视脚本的实时输出，不入库
local-backups/logs/*.out
local-backups/logs/timeline-*.txt
# 每个版本目录里的 APK 只留本机：源码快照入库，75MB 的包不入库
local-backups/**/*.apk
